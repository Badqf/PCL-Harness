<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupLink"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardArgument" Margin="0,15" Title="连接选项">
                <StackPanel Margin="25,40,25,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="模式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="0" x:Name="ComboLatencyMode" Grid.ColumnSpan="2" local:SettingService.Key="LinkLatencyMode" Grid.Column="1">
                            <local:MyComboBoxItem Content="优先直连" IsSelected="True" ToolTip="尽量不进行中转，而是 P2P 直连。" />
                            <local:MyComboBoxItem Content="优先低延迟" ToolTip="如果使用中转节点能降低延迟，就不进行直连。&#xa;不过，这会增加社区节点的负载……" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardDirect" Margin="0,0,0,15" Title="直连模式">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox local:SettingService.Key="LinkDirectMode" Height="22"
                        Text="只使用 P2P 直连，不经过任何公共服务器"
                        ToolTip="开启后不再访问 easytier.cn 的节点列表与公共中继，房主直接在本机监听端口并尝试用 UPnP 在路由器上开洞。&#xa;&#xa;能连上的情况：&#xa;- 两台电脑在同一个局域网（最稳）&#xa;- 房主公网可达，或路由器支持并开启了 UPnP&#xa;&#xa;连不上的情况：&#xa;- 双方都在 NAT 后面且路由器不支持 UPnP/无法端口映射（此时必须有一方做端口映射）&#xa;&#xa;首次使用需要管理员权限创建虚拟网卡。" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                        Text="直连模式下，邀请内容会变成「房主地址|邀请码」，把整串发给朋友即可。同一局域网内可以直接连；公网连接依赖路由器 UPnP 或手动端口映射。" />
                    <local:MyCheckBox local:SettingService.Key="LinkAutoPublicIp" Height="22" Margin="0,15,0,0"
                        Text="创建房间后自动检测公网 IP（会向 ipify 等接口发起一次请求）"
                        ToolTip="关闭时只有你手动点「检测公网 IP」才会联网查询。&#xa;公网 IP 只在本机显示并写入本机地址文件，不会上传到任何服务器。" />
                    <local:MyCheckBox local:SettingService.Key="LinkWriteAddressFile" Height="22" Margin="0,10,0,0"
                        Text="把联机地址写入本机文件（供 Radmin 等外部工具读取）"
                        ToolTip="文件位置：PCLHarness\LinkAddress.json&#xa;内容：本机地址、外网地址、公网 IP、邀请码，不含任何密钥或令牌。&#xa;文件权限收紧为仅当前用户可读，退出联机或关闭启动器时自动删除。" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                        Text="隐私说明：公网 IP 属于敏感信息。本程序只在你主动点击「检测公网 IP」或勾选上方自动检测时才会获取，不写日志、不上传、不参与任何统计；截图分享前请先把地址打码。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="高级设置" IsSwapped="True" CanSwap="True">
                <Grid Margin="25,40,25,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义节点" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextCustomPeer" local:SettingService.Key="LinkCustomPeer" Grid.Column="1" MaxHeight="28" 
                        ToolTip="覆盖 PCL 所选择的节点，仅连接此处填写的节点。&#xa;如果你自己搭建了 EasyTier 节点，你可以用这个设置让 PCL 连接它。&#xa;&#xa;使用逗号分隔多个节点，例如：&#xa;tcp://public.easytier.cn:11010,tcp://public2.easytier.cn:54321&#xa;&#xa;房主和加入者必须连接到至少一个相同节点，才能互相连上。" />
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <local:MyButton MinWidth="140" Padding="13,5" Margin="0,0,20,0" HorizontalAlignment="Left"
                            Text=" 光荣地贡献节点！" ColorType="Highlight"
                            ToolTip="联机功能全靠社区的各位无私贡献的节点才能存在！&#xa;如果你有空闲的高带宽服务器，欢迎搭建一个共享节点，人人为我，我为人人嘛……" 
                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://shimo.im/docs/qKPttVvXKqPD8YDC#anchor-Dupo" />
                        <local:MyButton MinWidth="140" Padding="13,5" Margin="0,0,20,0" HorizontalAlignment="Left"
                            Text="节点状态"
                            local:CustomEventService.EventType="打开网页" local:CustomEventService.EventData="https://uptime.easytier.cn/" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
