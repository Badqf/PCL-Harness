<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupLink"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardArgument" Margin="0,15" Title="连接方式">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock TextWrapping="Wrap" Opacity="0.65" FontSize="12"
                        Text="联机只使用 P2P 直连，不经过任何公共服务器。虚拟局域网（TUN）模式的开关在联机页顶部。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardDirect" Margin="0,0,0,15" Title="直连设置">
                <StackPanel Margin="25,40,25,20">
                    <local:MyCheckBox local:SettingService.Key="LinkAutoOpen" Height="22"
                        Text="启动时自动打开联机页"
                        ToolTip="开启后启动器会直接跳到联机页，省去自己点一下。" />
                    <local:MyCheckBox local:SettingService.Key="LinkAutoPublicIp" Height="22" Margin="0,10,0,0"
                        Text="创建房间后自动检测公网 IP"
                        ToolTip="会向 ipify 等接口发起一次请求；公网 IP 只在本机显示。" />
                    <local:MyCheckBox local:SettingService.Key="LinkWriteAddressFile" Height="22" Margin="0,10,0,0"
                        Text="把联机地址写入本机文件（供外部工具读取）"
                        ToolTip="文件位置：PCLHarness\LinkAddress.json，退出联机或关闭启动器时自动删除。" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                        Text="公网 IP 属于敏感信息，只在本机使用，不写日志、不上传。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="高级设置" IsSwapped="True" CanSwap="True">
                <Grid Margin="25,40,25,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自定义节点" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextCustomPeer" local:SettingService.Key="LinkCustomPeer" Grid.Column="1" MaxHeight="28"
                        ToolTip="只在你自己搭了 EasyTier 节点时才需要填，多个节点用逗号分隔。" />
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
